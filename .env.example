# Copie ce fichier en « .env » pour changer ces valeurs sur ta machine.
#
# ATTENTION : dans un site React, tout ce qui commence par VITE_ est intégré
# au JavaScript envoyé aux visiteurs. Ces valeurs sont donc PUBLIQUES.
# Ne mets jamais ici de mot de passe, de clé d'API ni de jeton.

VITE_PHONE_DISPLAY=06 83 00 49 03
VITE_PHONE_TEL=0683004903
VITE_CV_URL=cv/cv_lucas_dubuis_pdf_alternance.pdf
VITE_GITHUB_URL=https://github.com/lucasdbsfrost
